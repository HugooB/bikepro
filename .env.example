# Path to the SQLite database file (defaults to ./data/bikepro.db)
DATABASE_PATH=data/bikepro.db

# Public address of the app. With https:// the sign-in cookie is marked Secure (sent over
# HTTPS only), so set this whenever the app runs behind HTTPS.
APP_URL=http://localhost:3000

# Anyone can create the first account. After that, set this to true to let others register
# (e.g. family), then remove it again.
ALLOW_REGISTRATION=false

# Added in later milestones:
# STRAVA_CLIENT_ID=     (M8)
# STRAVA_CLIENT_SECRET= (M8)
