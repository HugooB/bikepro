# Path to the SQLite database file (defaults to ./data/bikepro.db)
DATABASE_PATH=data/bikepro.db

# Public address of the app. With https:// the sign-in cookie is marked Secure (sent over
# HTTPS only), so set this whenever the app runs behind HTTPS.
APP_URL=http://localhost:3000

# The admin account, created on the first start so nobody else can claim this install.
# The password is only used to create the account: changing it here later has no effect.
# The admin opens and closes registration for others under Settings → Admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Strava sync (optional). Create an app at https://www.strava.com/settings/api with the
# APP_URL host as its "Authorization Callback Domain". See README → Strava.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
